# Public production origin. Replace after the first Vercel deployment.
VANA_APP_URL=https://your-dna-project.vercel.app

# Create this in Vana Account. Never commit the real value.
VANA_APP_PRIVATE_KEY=

# The current Vana direct-data product stack uses production in both networks.
VANA_ENV=production

# Use moksha while testing. Change to mainnet only after the test flow passes.
VANA_NETWORK=moksha
