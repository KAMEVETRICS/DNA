# Public production origin. Must match the App URL registered in Vana Account.
VANA_APP_URL=https://dna-vana.vercel.app

# Create this in Vana Account (Protocol network: Mainnet). Never commit the real value.
VANA_APP_PRIVATE_KEY=

# Production product stack for Direct data flow.
VANA_ENV=production

# Cup scoring requires mainnet. Use moksha only for free testnet development.
VANA_NETWORK=mainnet
